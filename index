const svg = document.getElementById('sim');
const $ = id => document.getElementById(id);
const synth = window.speechSynthesis;

let playing = false, narrationOn = true, speaking = false;
let spoken = -1, lastT = 0, k = 0.38;        // k = seconds per word at rate 1
let voices = [], voice = null, watchdog = null;

svg.pauseAnimations();
svg.setCurrentTime(0);

const now = () => svg.getCurrentTime() % D;
const mmss = t => { t = Math.floor(t); return String(Math.floor(t/60)).padStart(2,'0') + ':' + String(t%60).padStart(2,'0'); };
const indexAt = t => { let i = 0; while (i + 1 < N && S[i+1].start <= t) i++; return i; };

/* ---------------- voices ---------------- */
const MALE = /\b(male(?!.*female)|david|mark|george|james|richard|guy|daniel|alex|fred|thomas|ryan|eric|brian|christopher)\b/i;
const FEMALE = /(female|zira|susan|hazel|samantha|karen|victoria|aria|jenny|linda|heather|catherine|moira|tessa|fiona)/i;

function loadVoices() {
  if (!synth) { $('hint').innerHTML = '<span class="warn">This browser has no speech support. Captions will still play.</span>'; return; }
  voices = synth.getVoices().filter(v => /^en/i.test(v.lang));
  const sel = $('voice'); sel.innerHTML = '';
  voices.forEach((v, i) => { const o = document.createElement('option'); o.value = i; o.textContent = v.name + ' (' + v.lang + ')'; sel.appendChild(o); });
  if (!voices.length) { sel.innerHTML = '<option>no English voice found</option>'; return; }
  let best = voices.findIndex(v => MALE.test(v.name) && !FEMALE.test(v.name));
  if (best < 0) best = voices.findIndex(v => !FEMALE.test(v.name));
  if (best < 0) best = 0;
  sel.value = best; voice = voices[best];
}
if (synth) { synth.onvoiceschanged = loadVoices; loadVoices(); }
$('voice').addEventListener('change', e => { voice = voices[e.target.value] || null; });

/* ---------------- narrator (follows the animation clock) ---------------- */
function speak(i, t) {
  const it = S[i];
  const slot = it.end - it.start;
  const target = Math.max(1, Math.min(slot * 0.90, (it.end - t) * 0.92));
  const rate = Math.min(2, Math.max(0.7, k * it.words / target));

  const u = new SpeechSynthesisUtterance(it.text);
  u.lang = voice ? voice.lang : 'en-US';
  if (voice) u.voice = voice;
  u.rate = rate; u.pitch = 0.9; u.volume = 1;

  let t0 = 0;
  const done = () => { clearTimeout(watchdog); speaking = false; spoken = i; };
  u.onstart = () => { t0 = performance.now(); };
  u.onend = () => {
    if (t0) { const d = (performance.now() - t0) / 1000; if (d > 0.4) k = 0.5 * k + 0.5 * (d * rate / it.words); }
    done();
  };
  u.onerror = done;

  speaking = true;
  clearTimeout(watchdog);
  watchdog = setTimeout(done, (slot + 8) * 1000);   // never get stuck
  synth.speak(u);
}

function tick() {
  const t = now();
  $('status').textContent = mmss(t) + ' / 03:30  |  caption ' + (indexAt(t) + 1) + '/' + N +
    (narrationOn && speaking ? '  |  speaking' : '');
  $('narr').style.opacity = narrationOn ? 1 : 0.15;

  if (!playing) return;

  if (t < lastT - 1) {                      // the show looped / restarted
    if (synth) synth.cancel();
    speaking = false; spoken = -1;
  }
  lastT = t;

  if (!narrationOn || !synth || speaking || !voices.length) return;

  let nxt = spoken + 1;
  while (nxt < N && t >= S[nxt].end) { nxt++; spoken = nxt - 1; }   // slot already over
  if (nxt >= N || t < S[nxt].start) return;
  speak(nxt, t);
}
setInterval(tick, 100);

/* ---------------- controls ---------------- */
function play() {
  svg.unpauseAnimations();
  if (synth && synth.paused) synth.resume();
  playing = true; $('play').innerHTML = '&#9208; PAUSE';
  const t = now(); if (spoken < 0 && t > 1) spoken = indexAt(t);
}
function pause() {
  svg.pauseAnimations();
  if (synth) synth.pause();
  playing = false; $('play').innerHTML = '&#9654; PLAY';
}
$('play').addEventListener('click', () => playing ? pause() : play());

$('restart').addEventListener('click', () => {
  if (synth) { synth.cancel(); synth.resume(); }
  speaking = false; spoken = -1; lastT = 0;
  svg.setCurrentTime(0);
  play();
});

$('narr-on').addEventListener('change', e => {
  narrationOn = e.target.checked;
  if (synth) { synth.cancel(); }
  speaking = false;
  const t = now(); spoken = t > 1 ? indexAt(t) : -1;     // resume without repeating
});
</script>
</body>
</html>
